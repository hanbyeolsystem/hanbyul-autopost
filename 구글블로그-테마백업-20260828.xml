한별시스템 구글블로그(hanbyeolsystem.blogspot.com) 카드 썸네일 패치
- 증상: 첫 화면 "최근 설치&#183;수리 후기" 카드에 사진 대신 파란 자리표시자
- 원인: 블로거는 구글 서버에 올린 사진만 대표이미지로 인식.
        자동발행 글(네이버/Supabase 사진)은 대표이미지가 안 생김.
- 동작: 글 피드에서 본문 첫 사진을 찾아 카드에 채워 넣음(과거+미래 글 전부)
- 설치: blogger.com &#8594; 테마 &#8594; (맞춤설정 옆 &#9660;) &#8594; HTML 편집
        &#8594; Ctrl+F 로 </body> 찾기 &#8594; 바로 윗줄에 아래 전체 붙여넣기 &#8594; 저장
================================================================ -->
<script>//<![CDATA[
(function () {
  var phs = document.querySelectorAll('a.post-thumb .post-thumb-ph');
  if (!phs.length || !window.fetch) return;
  fetch('/feeds/posts/default?alt=json&max-results=50')
    .then(function (r) { return r.json(); })
    .then(function (d) {
      var map = {};
      (d.feed.entry || []).forEach(function (e) {
        var href = '';
        (e.link || []).forEach(function (l) { if (l.rel === 'alternate') href = l.href; });
        var m = /<img[^>]+src="([^"]+)"/.exec(e.content ? e.content.$t : '');
        if (href && m) map[href] = m[1];
      });
      phs.forEach(function (ph) {
        var a = ph.closest('a.post-thumb');
        var src = a && map[a.href];
        if (!src) return;
        var img = document.createElement('img');
        img.src = src;
        img.alt = '';
        img.loading = 'lazy';
        img.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;';
        a.appendChild(img);
        ph.style.display = 'none';
      });
    })
    .catch(function () {});
})();
//]]></script>


